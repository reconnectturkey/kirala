<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header>
    <h1>Lead Takip MVP</h1>
    <nav>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
      <a href="/leads" class="<%= currentPath === '/leads' ? 'active' : '' %>">Lead Listesi</a>
      <a href="/leads/new" class="<%= currentPath === '/leads/new' ? 'active' : '' %>">Yeni Lead</a>
      <a href="/followups/today" class="<%= currentPath === '/followups/today' ? 'active' : '' %>">Bugünkü Takipler</a>
      <a href="/followups/overdue" class="<%= currentPath === '/followups/overdue' ? 'active' : '' %>">Geciken Takipler</a>
    </nav>
  </header>

  <main>
    <h2><%= title %></h2>
    <p><%= subtitle %></p>

    <section class="table-wrap">
      <table>
        <thead>
          <tr><th>Ad Soyad</th><th>Telefon</th><th>Durum</th><th>Sorumlu</th><th>Sonraki Aksiyon</th></tr>
        </thead>
        <tbody>
          <% if (!leads.length) { %>
            <tr><td colspan="5"><%= emptyMessage %></td></tr>
          <% } %>
          <% leads.forEach((lead) => { %>
            <tr>
              <td><%= lead.full_name %></td>
              <td><%= lead.phone %></td>
              <td><%= lead.status %></td>
              <td><%= lead.owner %></td>
              <td><%= lead.next_action_date || '-' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
